{
  "name": "aeosys",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:biome && pnpm lint:ui",
    "lint:biome": "biome check .",
    "lint:ui": "oxlint --ignore-pattern '**/.agents/**'",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test:agent": "tsx --test src/lib/server/audit-agent/agent.test.ts",
    "test:fetcher": "tsx --test src/lib/server/audits/fetcher.test.ts",
    "test:cwv": "tsx --test src/lib/server/audits/core-web-vitals.test.ts",
    "doctor": "react-doctor",
    "doctor:staged": "react-doctor --staged",
    "scan": "react-scan http://localhost:3000",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@agent-browser/sandbox": "^0.39.1",
    "@base-ui/react": "^1.9.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@scalar/nextjs-api-reference": "0.12.11",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.104.0",
    "@vercel/sandbox": "^3.8.0",
    "@workflow/world-local": "^5.1.1",
    "@workflow/world-vercel": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "durable-harness": "0.0.1-beta.6",
    "lucide-react": "^1.60.0",
    "motion": "^12.43.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "react-doctor": "^0.9.18",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
