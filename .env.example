# Google AI Studio key. Set this to enable agent-led SEO + AI SEO audits.
GEMINI_API_KEY=

# Optional. Default uses the current low-cost Gemini Flash-Lite model.
# Set to gemini-flash-latest for the faster/full Flash model.
AEOSYS_GEMINI_MODEL=gemini-flash-lite-latest

# Optional Google Chrome UX Report API key. When unset, Core Web Vitals come from a
# keyless `agent-browser vitals` lab measurement instead of real-user field data.
CRUX_API_KEY=

# Clean Vercel Sandbox snapshot with agent-browser + Chromium installed (see README).
AGENT_BROWSER_SNAPSHOT_ID=

# Local browser access only. Vercel deployments authenticate through OIDC.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
